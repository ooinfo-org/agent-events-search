# =============================================================================
# CONFIGURAÇÃO BASE — obrigatória em TODOS os modos
# =============================================================================

# LLM principal (extrai eventos do conteúdo encontrado)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1

# ooinfo — destino dos eventos
# ooinfo.org.br = DEV (default) | ooinfo.org = PRODUÇÃO
OOINFO_BASE_URL=https://ooinfo.org.br
OOINFO_LIST_ID_EVENTOS=cms3ippif002gwfsw2lo4g4fz
USER_LOGIN=dev1@decen.info
PASS_LOGIN=

# Horizonte de coleta
EVENT_LOOKAHEAD_DAYS=7
MAX_EVENTS_PER_CAPITAL=500

# =============================================================================
# MODO 1 — SIMPLES (npm run modo:simples)
# Usa a ferramenta de busca nativa do modelo (web_search_preview da OpenAI).
# Não precisa de nenhuma configuração extra além da BASE acima.
# =============================================================================

AGENT_PROVIDER=openai

# Alternativa: usar OpenRouter com modelo :online (busca via Exa)
# AGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o:online
# OPENROUTER_REFERER=https://ooinfo.org.br
# OPENROUTER_TITLE=base-eventos

# =============================================================================
# MODO 2 — BRAVE API (npm run modo:brave)
# Requer conta gratuita em api.search.brave.com (2000 buscas/mês grátis).
# =============================================================================

# BRAVE_API_KEY=BSA...

# =============================================================================
# MODO 3 — TAVILY API (npm run modo:tavily)
# Requer conta em app.tavily.com (1000 buscas/mês grátis, melhor qualidade).
# =============================================================================

# TAVILY_API_KEY=tvly-...

# =============================================================================
# MODO 4 — BROWSER (npm run modo:browser)
# Playwright headless + Bing. Sem chave, completamente grátis.
# Requer: npx playwright install chromium (feito uma vez).
# =============================================================================

# Nenhuma variável extra necessária para o modo browser.
